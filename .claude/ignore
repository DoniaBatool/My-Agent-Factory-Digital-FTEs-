# .claude/ignore
# Files and patterns that Claude Code should ignore

# System files
.DS_Store
._.DS_Store
**/.DS_Store
Thumbs.db

# Logs
*.log
logs/
*.log.*

# Dependencies
node_modules/
venv/
env/
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml
*.cover

# Build artifacts
dist/
build/
*.egg
*.whl

# Environment
.env
.env.local
.env.*.local
*.key
*.pem

# Git
.git/
.gitignore

# Temporary files
tmp/
temp/
*.tmp
*.bak

# Large files
*.mp4
*.mov
*.avi
*.zip
*.tar.gz
*.7z

# Claude memory (already loaded automatically)
.claude/memory/
